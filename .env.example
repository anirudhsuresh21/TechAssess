# ========================================================
# TechAssess Environment Configuration
# ========================================================

# Server port
PORT=4000
NODE_ENV=development

# Database Connection
# NOTE: Leave empty to automatically spin up an embedded in-memory MongoDB!
# No external MongoDB installation or cloud connection required for local development.
# MONGODB_URI=mongodb://localhost:27017/techassess
MONGODB_URI=

# Security & Token Hashing
JWT_SECRET=techassess-super-secret-jwt-key-2026-production-ready
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins
CORS_ORIGIN=http://localhost:3000
CLIENT_URL=http://localhost:3000

# Next.js Web App API endpoint
NEXT_PUBLIC_API_URL=http://localhost:4000
